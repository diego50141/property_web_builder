<div class="bg-white rounded-2xl shadow-xl p-8">
  <div class="text-center">
    <!-- Success Icon -->
    <div class="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-6">
      <span class="text-4xl text-green-600">&#10003;</span>
    </div>

    <h2 class="text-3xl font-bold text-gray-900 mb-2">¡Tu sitio está listo!</h2>
    <p class="text-gray-600 mb-8">¡Felicitaciones! Tu sitio inmobiliario fue creado.</p>

    <!-- Website URL -->
    <div class="bg-indigo-50 rounded-lg p-6 mb-8">
      <p class="text-sm text-gray-500 mb-2">Tu sitio está publicado en:</p>
      <a
        href="<%= @website.primary_url %>"
        target="_blank"
        class="text-xl font-mono text-indigo-600 hover:text-indigo-800 break-all"
      >
        <%= @website.primary_url %>
      </a>
    </div>

    <!-- Action Buttons -->
    <div class="space-y-3">
      <a
        href="<%= @website.primary_url %>"
        target="_blank"
        class="block w-full bg-indigo-600 text-white py-3 px-4 rounded-lg font-semibold text-lg hover:bg-indigo-700 transition-colors"
      >
        Ver mi sitio &#8599;
      </a>
      <a
        href="<%= @website.primary_url %>/site_admin"
        target="_blank"
        class="block w-full bg-white text-indigo-600 border-2 border-indigo-600 py-3 px-4 rounded-lg font-semibold text-lg hover:bg-indigo-50 transition-colors"
      >
        Ir al panel de administración &#8594;
      </a>
    </div>
  </div>
</div>

<!-- Next Steps -->
<div class="mt-8 bg-white rounded-2xl shadow-xl p-8">
  <h3 class="text-xl font-bold text-gray-900 mb-6">Próximos pasos</h3>
  <div class="space-y-4">
    <div class="flex items-start">
      <div class="flex-shrink-0 w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600 font-bold">
        1
      </div>
      <div class="ml-4">
        <h4 class="font-semibold text-gray-900">Define tu contraseña</h4>
        <p class="text-sm text-gray-500">Revisa tu correo (<%= @user&.email %>) con las instrucciones de acceso</p>
      </div>
    </div>
    <div class="flex items-start">
      <div class="flex-shrink-0 w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600 font-bold">
        2
      </div>
      <div class="ml-4">
        <h4 class="font-semibold text-gray-900">Publica tus inmuebles</h4>
        <p class="text-sm text-gray-500">Reemplaza las propiedades de ejemplo por tu inventario real</p>
      </div>
    </div>
    <div class="flex items-start">
      <div class="flex-shrink-0 w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600 font-bold">
        3
      </div>
      <div class="ml-4">
        <h4 class="font-semibold text-gray-900">Personaliza tu sitio</h4>
        <p class="text-sm text-gray-500">Ajusta colores, logo y contenido a tu marca</p>
      </div>
    </div>
    <div class="flex items-start">
      <div class="flex-shrink-0 w-8 h-8 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600 font-bold">
        4
      </div>
      <div class="ml-4">
        <h4 class="font-semibold text-gray-900">Conecta tu dominio (opcional)</h4>
        <p class="text-sm text-gray-500">Usa tu propio dominio en vez del subdominio</p>
      </div>
    </div>
  </div>
</div>

<!-- Support -->
<div class="mt-8 text-center text-sm text-gray-500">
  <p>
    ¿Necesitas ayuda? Consulta la
    <a href="#" class="text-indigo-600 hover:text-indigo-500">documentación</a>
    o
    <a href="#" class="text-indigo-600 hover:text-indigo-500">escríbenos a soporte</a>.
  </p>
</div>
