<div class="bg-white rounded-2xl shadow-xl p-8">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-900">Crea tu sitio inmobiliario</h2>
    <p class="mt-2 text-gray-600">Empieza en solo unos minutos</p>
  </div>

  <%= form_tag signup_start_path, method: :post, class: "space-y-6" do %>
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
        Correo electrónico
      </label>
      <input
        type="email"
        name="email"
        id="email"
        required
        autofocus
        placeholder="tu@ejemplo.com"
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-lg"
      >
      <p class="mt-2 text-sm text-gray-500">
        Lo usaremos para configurar tu cuenta
      </p>
    </div>

    <button
      type="submit"
      class="w-full bg-indigo-600 text-white py-3 px-4 rounded-lg font-semibold text-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors"
    >
      Comenzar
    </button>
  <% end %>

  <div class="mt-8 pt-6 border-t text-center">
    <p class="text-sm text-gray-500">
      ¿Ya tienes una cuenta?
      <%= link_to "Inicia sesión", new_user_session_path, class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
    </p>
  </div>
</div>

<div class="mt-8 text-center">
  <h3 class="text-lg font-semibold text-gray-800 mb-4">Qué incluye:</h3>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm text-gray-600">
    <div class="bg-white/50 rounded-lg p-4">
      <div class="text-2xl mb-2">&#127968;</div>
      <div class="font-medium">Listado de inmuebles</div>
      <div class="text-gray-500">Publica tus propiedades</div>
    </div>
    <div class="bg-white/50 rounded-lg p-4">
      <div class="text-2xl mb-2">&#127760;</div>
      <div class="font-medium">Tu propio subdominio</div>
      <div class="text-gray-500">tunombre.propertywebbuilder.com</div>
    </div>
    <div class="bg-white/50 rounded-lg p-4">
      <div class="text-2xl mb-2">&#128640;</div>
      <div class="font-medium">Listo en minutos</div>
      <div class="text-gray-500">Preconfigurado y listo para usar</div>
    </div>
  </div>
</div>
