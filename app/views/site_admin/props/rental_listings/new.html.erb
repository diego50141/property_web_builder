<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Nuevo anuncio de arriendo</h1>
    <p class="mt-1 text-gray-600">Crea un nuevo anuncio de arriendo para la propiedad <%= @realty_asset.reference %></p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: @rental_listing, url: site_admin_prop_rental_listings_path(@realty_asset), local: true do |f| %>
      <%= render 'form', f: f, listing: @rental_listing %>

      <div class="flex justify-between items-center mt-6 pt-6 border-t border-gray-200">
        <%= link_to 'Cancelar', edit_sale_rental_site_admin_prop_path(@realty_asset), class: 'text-gray-600 hover:text-gray-800' %>
        <%= f.submit 'Crear anuncio de arriendo', class: 'px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 cursor-pointer' %>
      </div>
    <% end %>
  </div>
</div>
