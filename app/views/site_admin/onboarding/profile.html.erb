<div class="max-w-3xl mx-auto">
  <%= render 'progress', steps: @steps, current_step: @step, total_steps: @steps.keys.max %>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <!-- Header -->
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Configura tu perfil</h1>
      <p class="text-gray-600">Cuéntales a los visitantes sobre tu inmobiliaria o negocio. Esta información aparecerá en tu sitio web.</p>
    </div>

    <%= form_with model: @agency, url: site_admin_onboarding_path(step: @step), method: :post, local: true do |f| %>
      <div class="space-y-6">

        <!-- Currency Selection - PERMANENT SETTING -->
        <div class="bg-amber-50 border-2 border-amber-300 rounded-lg p-5">
          <div class="flex items-start mb-3">
            <div class="flex-shrink-0">
              <svg class="h-6 w-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-lg font-semibold text-amber-800">Elige tu moneda</h3>
              <p class="text-sm text-amber-700 mt-1">
                <strong>Importante:</strong> Esta configuración es permanente y no se puede cambiar después.
                Todos los precios de tus propiedades se guardarán en esta moneda.
              </p>
            </div>
          </div>

          <div class="mt-4">
            <label for="default_currency" class="block text-sm font-medium text-gray-700 mb-2">
              Moneda principal <span class="text-red-500">*</span>
            </label>
            <select name="default_currency" id="default_currency" required
                    class="block w-full rounded-lg border-2 border-amber-300 bg-white shadow-sm focus:border-amber-500 focus:ring-amber-500 text-base px-4 py-3">
              <% Pwb::Config.currency_options_for_select.each do |label, code| %>
                <option value="<%= code %>" <%= 'selected' if code == (@website&.default_currency || 'EUR') %>>
                  <%= label %>
                </option>
              <% end %>
            </select>
            <p class="mt-2 text-xs text-amber-800">
              <svg class="inline h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
              Elige la moneda que usarás para publicar los precios de las propiedades. Los visitantes pueden ver opcionalmente los precios convertidos a otras monedas.
            </p>
          </div>
        </div>

        <!-- Business Name -->
        <div>
          <%= f.label :display_name, "Nombre del negocio / inmobiliaria", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :display_name,
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 border",
              placeholder: "Nombre de tu empresa",
              required: true %>
          <% if @agency.errors[:display_name].any? %>
            <p class="mt-1 text-sm text-red-600"><%= @agency.errors[:display_name].first %></p>
          <% end %>
        </div>

        <!-- Company Name (Legal) -->
        <div>
          <%= f.label :company_name, "Razón social (legal)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :company_name,
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 border",
              placeholder: "Tu Empresa S.A.S." %>
          <p class="mt-1 text-xs text-gray-500">Opcional: el nombre registrado de tu empresa si es diferente del nombre visible</p>
        </div>

        <!-- Contact Information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :email_primary, "Correo electrónico", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.email_field :email_primary,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 border",
                placeholder: "contacto@tuempresa.com" %>
          </div>

          <div>
            <%= f.label :phone_number_primary, "Teléfono", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :phone_number_primary,
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-4 py-2 border",
                placeholder: "+57 300 123 4567" %>
          </div>
        </div>

      </div>

      <!-- Tip -->
      <div class="mt-6 bg-blue-50 rounded-lg p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-blue-700">
              Puedes añadir tu dirección y más detalles después en la sección de Configuración del sitio web.
            </p>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex justify-between mt-8 pt-6 border-t border-gray-200">
        <%= link_to "Atrás", site_admin_onboarding_path(step: @step - 1), class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>

        <%= f.submit "Guardar y continuar", class: "inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
