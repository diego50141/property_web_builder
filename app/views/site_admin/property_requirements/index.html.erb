<div class="max-w-7xl mx-auto">
  <%= render 'site_admin/shared/page_header',
      title: 'Búsquedas en portales',
      description: 'Requerimientos de clientes buscados en Metrocuadrado y Fincaraíz' %>

  <div class="mb-6 flex justify-end">
    <%= link_to 'Nueva búsqueda', new_site_admin_property_requirement_path,
        class: 'px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700' %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Requerimiento</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Resultados</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @requirements.any? %>
          <% @requirements.each do |req| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <% if req.contact %>
                  <%= [req.contact.first_name, req.contact.last_name].compact.join(' ').presence || req.contact.primary_email %>
                <% else %>
                  <span class="text-gray-400">Sin cliente</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500">
                <%= render 'summary', requirement: req %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= render 'status_badge', requirement: req %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= req.completed? ? req.results_count : '—' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= format_date(req.created_at) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-3">
                <%= link_to 'Ver', site_admin_property_requirement_path(req), class: 'text-blue-600 hover:text-blue-800' %>
                <%= button_to 'Eliminar', site_admin_property_requirement_path(req), method: :delete,
                    form: { data: { turbo_confirm: '¿Eliminar esta búsqueda y sus resultados?' }, class: 'inline' },
                    class: 'text-red-600 hover:text-red-800 bg-transparent' %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="px-6 py-12">
              <%= render 'site_admin/shared/empty_state',
                  title: 'Aún no hay búsquedas',
                  description: 'Crea un requerimiento (ej. apartamento en venta en Bogotá, 300-400M, 2 habitaciones) y el sistema buscará las opciones en Metrocuadrado y Fincaraíz.',
                  icon: 'search' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
