<%
  input = "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm"
  label = "block text-sm font-medium text-gray-700 mb-1"
%>
<div class="max-w-3xl mx-auto">
  <%= render 'site_admin/shared/page_header',
      title: 'Nueva búsqueda',
      description: 'Define el requerimiento del cliente y el sistema buscará las opciones en Metrocuadrado y Fincaraíz' %>

  <% if @requirement.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% @requirement.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: site_admin_property_requirements_path, method: :post, local: true do %>
    <div class="bg-white rounded-lg shadow border-t-4 border-blue-500 p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
          <label class="<%= label %>">Cliente (opcional)</label>
          <select name="property_requirement[contact_id]" class="<%= input %>">
            <option value="">— Sin cliente —</option>
            <% @contacts.each do |c| %>
              <option value="<%= c.id %>" <%= 'selected' if @requirement.contact_id == c.id %>>
                <%= [c.first_name, c.last_name].compact.join(' ').presence || c.primary_email %>
              </option>
            <% end %>
          </select>
        </div>

        <div>
          <label class="<%= label %>">Operación</label>
          <select name="property_requirement[operation_type]" class="<%= input %>">
            <option value="venta" <%= 'selected' if @requirement.operation_type == 'venta' %>>Compra (venta)</option>
            <option value="arriendo" <%= 'selected' if @requirement.operation_type == 'arriendo' %>>Arriendo</option>
          </select>
        </div>
        <div>
          <label class="<%= label %>">Tipo de inmueble</label>
          <select name="property_requirement[property_type_key]" class="<%= input %>">
            <% @property_type_options.each do |(name, value)| %>
              <option value="<%= value %>" <%= 'selected' if @requirement.property_type_key == value %>><%= name %></option>
            <% end %>
          </select>
        </div>

        <div class="md:col-span-2">
          <label class="<%= label %>">Ciudad</label>
          <select name="property_requirement[city]" class="<%= input %>">
            <% @city_options.each do |city| %>
              <option value="<%= city %>" <%= 'selected' if @requirement.city == city %>><%= city %></option>
            <% end %>
          </select>
          <p class="mt-1 text-xs text-gray-500">Por ahora solo las ciudades verificadas en los portales soportados.</p>
        </div>

        <div>
          <label class="<%= label %>">Precio mínimo (COP)</label>
          <input type="text" name="property_requirement[price_min]" inputmode="numeric"
                 value="<%= @requirement.price_min_cents ? @requirement.price_min_cents / 100 : '' %>"
                 placeholder="300.000.000" class="<%= input %>">
        </div>
        <div>
          <label class="<%= label %>">Precio máximo (COP)</label>
          <input type="text" name="property_requirement[price_max]" inputmode="numeric"
                 value="<%= @requirement.price_max_cents ? @requirement.price_max_cents / 100 : '' %>"
                 placeholder="400.000.000" class="<%= input %>">
        </div>

        <div>
          <label class="<%= label %>">Habitaciones (mínimo)</label>
          <input type="number" name="property_requirement[bedrooms_min]" min="0" max="20"
                 value="<%= @requirement.bedrooms_min %>" class="<%= input %>">
        </div>
        <div>
          <label class="<%= label %>">Baños (mínimo)</label>
          <input type="number" name="property_requirement[bathrooms_min]" min="0" max="20"
                 value="<%= @requirement.bathrooms_min %>" class="<%= input %>">
        </div>
      </div>
    </div>

    <div class="mt-6 flex justify-end gap-3">
      <%= link_to 'Cancelar', site_admin_property_requirements_path,
          class: 'px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50' %>
      <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
        Buscar en los portales
      </button>
    </div>
  <% end %>
</div>
