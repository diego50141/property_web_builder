<%
  stage_colors = {
    'nuevo' => 'bg-gray-100 text-gray-700 border-gray-300',
    'contactado' => 'bg-blue-100 text-blue-700 border-blue-300',
    'calificado' => 'bg-indigo-100 text-indigo-700 border-indigo-300',
    'visita' => 'bg-purple-100 text-purple-700 border-purple-300',
    'negociacion' => 'bg-amber-100 text-amber-700 border-amber-300',
    'ganado' => 'bg-green-100 text-green-700 border-green-300',
    'perdido' => 'bg-red-100 text-red-700 border-red-300'
  }
%>

<div class="max-w-full">
  <div class="mb-6">
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Pipeline de prospectos</h1>
    <p class="mt-1 text-gray-600"><%= @total %> prospecto(s). Arrastra la vista para ver todas las etapas; usa los menús de cada tarjeta para mover de etapa o asignar un agente.</p>
  </div>

  <div class="overflow-x-auto pb-4">
    <div class="flex gap-4 min-w-max">
      <% Pwb::Contact::STAGES.each do |stage| %>
        <% cards = @contacts_by_stage[stage] %>
        <div class="w-72 flex-shrink-0">
          <div class="flex items-center justify-between mb-3 px-1">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border <%= stage_colors[stage] %>">
              <%= Pwb::Contact::STAGE_LABELS[stage] %>
            </span>
            <span class="text-xs font-medium text-gray-400"><%= cards.size %></span>
          </div>

          <div class="space-y-3 min-h-[60px]">
            <% cards.each do |c| %>
              <% name = [c.first_name, c.last_name].map(&:presence).compact.join(' ').presence || c.primary_email.presence || "Contacto ##{c.id}" %>
              <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-3">
                <p class="font-medium text-gray-900 text-sm truncate" title="<%= name %>"><%= name %></p>
                <% if c.primary_email.present? %>
                  <p class="text-xs text-gray-500 truncate"><%= c.primary_email %></p>
                <% end %>
                <% if c.primary_phone_number.present? %>
                  <p class="text-xs text-gray-500"><%= c.primary_phone_number %></p>
                <% end %>
                <% if c.source.present? %>
                  <span class="inline-block mt-1 text-[10px] uppercase tracking-wide text-gray-400">Fuente: <%= c.source %></span>
                <% end %>

                <%= form_with url: site_admin_pipeline_update_path(c.id), method: :patch, local: true, class: "mt-2 space-y-1.5" do %>
                  <select name="stage" onchange="this.form.requestSubmit()"
                          class="w-full text-xs border border-gray-200 rounded px-2 py-1 focus:ring-1 focus:ring-blue-500">
                    <% Pwb::Contact::STAGES.each do |s| %>
                      <option value="<%= s %>" <%= 'selected' if c.stage == s %>><%= Pwb::Contact::STAGE_LABELS[s] %></option>
                    <% end %>
                  </select>
                  <select name="assigned_user_id" onchange="this.form.requestSubmit()"
                          class="w-full text-xs border border-gray-200 rounded px-2 py-1 text-gray-600 focus:ring-1 focus:ring-blue-500">
                    <option value="">— Sin asignar —</option>
                    <% @agents.each do |a| %>
                      <option value="<%= a.id %>" <%= 'selected' if c.assigned_user_id == a.id %>><%= a.email %></option>
                    <% end %>
                  </select>
                <% end %>
              </div>
            <% end %>

            <% if cards.empty? %>
              <div class="text-center text-xs text-gray-300 py-6 border-2 border-dashed border-gray-100 rounded-lg">Sin prospectos</div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
