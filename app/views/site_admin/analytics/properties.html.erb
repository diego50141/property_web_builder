<div class="analytics-properties">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold">Rendimiento de propiedades</h1>
      <p class="text-gray-500">Ve qué anuncios atraen más atención</p>
    </div>

    <%= link_to "Volver al resumen", site_admin_analytics_path, class: "text-blue-600 hover:underline" %>
  </div>

  <!-- Property Views Chart -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <h3 class="text-lg font-semibold mb-4">Vistas de propiedades a lo largo del tiempo</h3>
    <%= line_chart @property_views_by_day,
        xtitle: "Fecha",
        ytitle: "Vistas",
        colors: ["#10B981"] %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Top Properties -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-lg font-semibold mb-4">Propiedades más vistas</h3>
      <% if @top_properties.any? %>
        <table class="w-full">
          <thead>
            <tr class="text-left text-gray-500 text-sm">
              <th class="pb-2">Propiedad</th>
              <th class="pb-2 text-right">Vistas</th>
            </tr>
          </thead>
          <tbody>
            <% @top_properties.each do |property_info, count| %>
              <tr class="border-t">
                <td class="py-2">
                  <% if property_info.is_a?(Hash) %>
                    <span class="font-medium"><%= property_info[:reference] || "ID: #{property_info[:id]}" %></span>
                    <% if property_info[:title] %>
                      <br><span class="text-sm text-gray-500"><%= truncate(property_info[:title], length: 40) %></span>
                    <% end %>
                  <% else %>
                    <span class="font-medium">Propiedad #<%= property_info %></span>
                  <% end %>
                </td>
                <td class="py-2 text-right font-semibold"><%= number_with_delimiter(count) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-gray-500">Aún no se han registrado vistas de propiedades.</p>
      <% end %>
    </div>

    <!-- Top Searches -->
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-lg font-semibold mb-4">Búsquedas populares</h3>
      <% if @top_searches.any? %>
        <table class="w-full">
          <thead>
            <tr class="text-left text-gray-500 text-sm">
              <th class="pb-2">Término de búsqueda</th>
              <th class="pb-2 text-right">Cantidad</th>
            </tr>
          </thead>
          <tbody>
            <% @top_searches.each do |query, count| %>
              <tr class="border-t">
                <td class="py-2"><%= query || "(búsqueda vacía)" %></td>
                <td class="py-2 text-right font-semibold"><%= number_with_delimiter(count) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-gray-500">Aún no se han registrado datos de búsqueda.</p>
      <% end %>
    </div>
  </div>
</div>
