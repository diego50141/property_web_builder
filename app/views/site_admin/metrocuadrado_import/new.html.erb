<% content_for :page_title, "Importar desde Metrocuadrado" %>

<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Importar desde Metrocuadrado</h1>
    <p class="mt-2 text-gray-600">
      Pega el enlace de tu página en Metrocuadrado y montamos tus propiedades
      automáticamente en tu sitio, con fotos y precios.
    </p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: site_admin_metrocuadrado_import_path, method: :post, local: true do %>
      <label for="url" class="block text-sm font-medium text-gray-700 mb-1">
        Enlace de Metrocuadrado
      </label>
      <input type="url" name="url" id="url" required
             value="<%= @url %>"
             placeholder="https://www.metrocuadrado.com/inmobiliaria/tu-inmobiliaria/1234"
             class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500">

      <div class="mt-2 text-sm text-gray-500 space-y-1">
        <p>Puedes pegar:</p>
        <ul class="list-disc list-inside">
          <li><strong>Toda tu agencia:</strong> <code>.../inmobiliaria/&lt;nombre&gt;/&lt;id&gt;</code> — importa todos tus inmuebles.</li>
          <li><strong>Una sola propiedad:</strong> <code>.../inmueble/&lt;...&gt;/&lt;id&gt;-M&lt;codigo&gt;</code></li>
        </ul>
      </div>

      <div class="mt-5 flex items-center gap-3">
        <button type="submit"
                class="inline-flex items-center px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg">
          Importar propiedades
        </button>
        <span class="text-xs text-gray-400">Importar una agencia completa puede tardar hasta ~1 minuto.</span>
      </div>
    <% end %>
  </div>

  <% if @results.present? %>
    <div class="mt-6 bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">
        Resultado: <%= @imported %> importada(s)<%= ", #{@errored} con error" if @errored.to_i.positive? %>
      </h2>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500 border-b">
              <th class="py-2 pr-4">Referencia</th>
              <th class="py-2 pr-4">Estado</th>
              <th class="py-2 pr-4">Fotos</th>
              <th class="py-2 pr-4">Detalle</th>
            </tr>
          </thead>
          <tbody>
            <% @results.each do |r| %>
              <tr class="border-b last:border-0">
                <td class="py-2 pr-4 font-mono text-xs"><%= r.reference || "—" %></td>
                <td class="py-2 pr-4">
                  <% if r.action == "imported" %>
                    <span class="inline-flex px-2 py-0.5 rounded text-xs bg-green-100 text-green-800">importada</span>
                  <% else %>
                    <span class="inline-flex px-2 py-0.5 rounded text-xs bg-red-100 text-red-800"><%= r.action %></span>
                  <% end %>
                </td>
                <td class="py-2 pr-4"><%= r.photos || 0 %></td>
                <td class="py-2 pr-4 text-gray-500"><%= r.error %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-4">
        <%= link_to "Ver mis anuncios", site_admin_props_path,
                    class: "text-blue-600 hover:text-blue-800 font-medium" %>
      </div>
    </div>
  <% end %>
</div>
