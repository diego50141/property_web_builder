<div class="px-4 sm:px-6 lg:px-8 py-8">
  <!-- Back link -->
  <div class="mb-6">
    <%= link_to site_admin_listing_videos_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
      <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Volver a los videos
    <% end %>
  </div>

  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-semibold text-gray-900">Generar video de propiedad</h1>
    <p class="mt-2 text-sm text-gray-500">
      Crea un video con IA para una publicación de propiedad. El video incluirá fotos, narración y música de fondo.
    </p>
  </div>

  <%= form_with url: site_admin_listing_videos_path, method: :post, class: "space-y-8" do |f| %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Form -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Property Selection -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Selecciona una propiedad</h3>

          <% if @properties.any? %>
            <div class="space-y-3">
              <% @properties.each do |property| %>
                <label class="flex items-start p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-blue-300 hover:bg-blue-50 transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
                  <input type="radio" name="listing_video[property_id]" value="<%= property.id %>"
                         class="mt-1 h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500">
                  <div class="ml-4 flex-1">
                    <div class="flex items-start justify-between">
                      <div>
                        <p class="font-medium text-gray-900"><%= property.street_address || 'Sin dirección' %></p>
                        <p class="text-sm text-gray-500"><%= property.city %>, <%= property.region %></p>
                      </div>
                      <% first_photo = property.prop_photos.first %>
                      <% if first_photo&.image&.attached? %>
                        <img src="<%= url_for(first_photo.image) %>" alt=""
                             class="w-16 h-12 rounded object-cover ml-4">
                      <% elsif first_photo&.external_url.present? %>
                        <img src="<%= first_photo.external_url %>" alt=""
                             class="w-16 h-12 rounded object-cover ml-4">
                      <% end %>
                    </div>
                    <div class="mt-2 flex items-center gap-4 text-xs text-gray-500">
                      <span><%= property.prop_type_key&.titleize %></span>
                      <% if property.count_bedrooms %>
                        <span><%= property.count_bedrooms %> hab.</span>
                      <% end %>
                      <% if property.count_bathrooms %>
                        <span><%= property.count_bathrooms %> baños</span>
                      <% end %>
                      <span class="text-blue-600"><%= property.prop_photos.count %> fotos</span>
                    </div>
                  </div>
                </label>
              <% end %>
            </div>

            <% if @properties.size >= 100 %>
              <p class="mt-4 text-sm text-gray-500">
                Mostrando las primeras 100 propiedades con 3 o más fotos.
              </p>
            <% end %>
          <% else %>
            <div class="text-center py-8">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <h3 class="mt-4 text-sm font-medium text-gray-900">No hay propiedades aptas</h3>
              <p class="mt-2 text-sm text-gray-500">
                Las propiedades necesitan al menos 3 fotos para generar un video.
              </p>
            </div>
          <% end %>
        </div>

        <!-- Video Options -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Opciones del video</h3>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Format -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Formato del video</label>
              <select name="listing_video[format]" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                <option value="vertical_9_16" selected>Vertical 9:16 (TikTok, Reels)</option>
                <option value="horizontal_16_9">Horizontal 16:9 (YouTube)</option>
                <option value="square_1_1">Cuadrado 1:1 (Instagram)</option>
              </select>
            </div>

            <!-- Style -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Estilo del video</label>
              <select name="listing_video[style]" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                <option value="professional" selected>Profesional</option>
                <option value="luxury">Lujo</option>
                <option value="casual">Informal</option>
                <option value="energetic">Enérgico</option>
                <option value="minimal">Minimalista</option>
              </select>
            </div>

            <!-- Voice -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Voz de la narración</label>
              <select name="listing_video[voice]" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                <option value="nova" selected>Nova (Profesional)</option>
                <option value="alloy">Alloy (Equilibrada)</option>
                <option value="echo">Echo (Cálida)</option>
                <option value="fable">Fable (Expresiva)</option>
                <option value="onyx">Onyx (Autoritaria)</option>
                <option value="shimmer">Shimmer (Clara)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Content Options -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Opciones de contenido</h3>

          <div class="space-y-4">
            <label class="flex items-center">
              <input type="checkbox" name="listing_video[include_price]" value="1" checked
                     class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              <span class="ml-3 text-sm text-gray-700">Incluir el precio en la narración</span>
            </label>

            <label class="flex items-center">
              <input type="checkbox" name="listing_video[include_address]" value="1" checked
                     class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              <span class="ml-3 text-sm text-gray-700">Incluir la dirección en la narración</span>
            </label>

            <label class="flex items-center">
              <input type="checkbox" name="listing_video[music_enabled]" value="1" checked
                     class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              <span class="ml-3 text-sm text-gray-700">Incluir música de fondo</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Info Card -->
        <div class="bg-blue-50 rounded-lg border border-blue-200 p-6">
          <h3 class="text-sm font-medium text-blue-800 mb-3">Cómo funciona</h3>
          <ol class="space-y-2 text-sm text-blue-700">
            <li class="flex items-start gap-2">
              <span class="font-medium">1.</span>
              <span>La IA genera un guion de narración basado en los detalles de la propiedad</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-medium">2.</span>
              <span>La conversión de texto a voz transforma el guion en audio</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-medium">3.</span>
              <span>Las fotos se ensamblan con efectos Ken Burns</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-medium">4.</span>
              <span>Se añade y mezcla la música de fondo</span>
            </li>
          </ol>
        </div>

        <!-- Style Guide -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-sm font-medium text-gray-700 mb-3">Guía de estilos</h3>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="font-medium text-gray-900">Profesional</dt>
              <dd class="text-gray-500">Seguro, centrado en las características, ritmo moderado</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-900">Lujo</dt>
              <dd class="text-gray-500">Sofisticado, elegante, ritmo más lento</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-900">Informal</dt>
              <dd class="text-gray-500">Amigable, conversacional, animado</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-900">Enérgico</dt>
              <dd class="text-gray-500">Emocionante, dinámico, ritmo rápido</dd>
            </div>
            <div>
              <dt class="font-medium text-gray-900">Minimalista</dt>
              <dd class="text-gray-500">Simple, directo, factual</dd>
            </div>
          </dl>
        </div>

        <!-- Cost Estimate -->
        <div class="bg-gray-50 rounded-lg border border-gray-200 p-6">
          <h3 class="text-sm font-medium text-gray-700 mb-2">Costo estimado</h3>
          <p class="text-2xl font-semibold text-gray-900">~$0.10</p>
          <p class="text-xs text-gray-500 mt-1">por video (IA + TTS + renderizado)</p>
        </div>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="flex justify-end gap-4 pt-6 border-t border-gray-200">
      <%= link_to 'Cancelar', site_admin_listing_videos_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900" %>
      <button type="submit" class="inline-flex items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        Generar video
      </button>
    </div>
  <% end %>
</div>
