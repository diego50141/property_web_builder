<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to '← Volver al equipo', site_admin_users_path, class: 'text-blue-600 hover:text-blue-800' %>
  </div>

  <div class="mb-6">
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Invitar miembro del equipo</h1>
    <p class="mt-2 text-gray-600">Añade un nuevo usuario al equipo de tu sitio web. Recibirá una invitación por correo.</p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: @user, url: site_admin_users_path, local: true do |f| %>
      <% if @user.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
          <h3 class="text-red-800 font-medium">Por favor corrige los siguientes errores:</h3>
          <ul class="mt-2 list-disc list-inside text-red-700 text-sm">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-6">
        <!-- Email -->
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email,
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "colega@ejemplo.com",
              required: true %>
          <p class="mt-1 text-sm text-gray-500">Si este correo ya tiene una cuenta, se añadirá a tu equipo.</p>
        </div>

        <!-- Name Fields -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :first_names, "Nombre", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :first_names,
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "Juan" %>
          </div>
          <div>
            <%= f.label :last_names, "Apellido", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :last_names,
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "Pérez" %>
          </div>
        </div>

        <!-- Role Selection -->
        <div>
          <%= f.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :role,
              [
                ['Lector - Puede ver propiedades y contenido', 'viewer'],
                ['Miembro - Puede editar propiedades y contenido', 'member'],
                ['Administrador - Acceso completo excepto transferencia de propiedad', 'admin'],
                ['Propietario - Acceso completo incluyendo facturación', 'owner']
              ],
              { selected: 'member' },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          <p class="mt-1 text-sm text-gray-500">Elige el nivel de acceso que debe tener este usuario.</p>
        </div>

        <!-- Role Descriptions -->
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="text-sm font-medium text-gray-700 mb-2">Permisos por rol</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li><strong>Lector:</strong> Acceso de solo lectura al panel y las propiedades</li>
            <li><strong>Miembro:</strong> Crear y editar propiedades, páginas y contenido</li>
            <li><strong>Administrador:</strong> Gestionar miembros del equipo, configuración y todo el contenido</li>
            <li><strong>Propietario:</strong> Acceso completo incluyendo facturación y transferencia de propiedad</li>
          </ul>
        </div>
      </div>

      <!-- Actions -->
      <div class="mt-8 pt-6 border-t flex justify-between items-center">
        <%= link_to "Cancelar", site_admin_users_path, class: "text-gray-600 hover:text-gray-800" %>
        <%= f.submit "Enviar invitación", class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
