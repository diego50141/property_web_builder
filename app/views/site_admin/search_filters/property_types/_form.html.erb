<%= form_with model: @property_type,
              url: @property_type.persisted? ? site_admin_search_filters_property_type_path(@property_type) : site_admin_search_filters_property_types_path,
              scope: :search_filter_option,
              method: @property_type.persisted? ? :patch : :post,
              local: true,
              class: "space-y-6" do |f| %>
  <% if @property_type.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <div class="flex">
        <svg class="w-5 h-5 text-red-600 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <h3 class="text-sm font-medium text-red-800">Por favor corrige los siguientes errores:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% @property_type.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Basic Settings -->
  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Configuración básica</h2>
    </div>
    <div class="px-6 py-4 space-y-4">
      <div>
        <%= f.label :global_key, "Clave", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :global_key,
                         class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 font-mono",
                         placeholder: "ej., apartment, villa, townhouse" %>
        <p class="mt-1 text-xs text-gray-500">
          Identificador único (minúsculas, se permiten guiones). Déjalo en blanco para generarlo automáticamente a partir del nombre.
        </p>
      </div>

      <div>
        <%= f.label :external_code, "Código del proveedor externo", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :external_code,
                         class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 font-mono",
                         placeholder: "ej., 1-1, APT, VILLA" %>
        <p class="mt-1 text-xs text-gray-500">
          Corresponde al código del tipo de propiedad del proveedor del feed externo (ej., Resales Online).
        </p>
      </div>

      <div>
        <%= f.label :parent_id, "Tipo principal", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :parent_id,
                     options_for_select(@parent_options.map { |pt| [pt.display_label, pt.id] }, @property_type.parent_id),
                     { include_blank: "Ninguno (Nivel superior)" },
                     class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
        <p class="mt-1 text-xs text-gray-500">
          Opcional: Crea un subtipo dentro de un tipo principal (ej., "Villa independiente" dentro de "Villa").
        </p>
      </div>

      <div>
        <%= f.label :icon, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :icon,
                         class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500",
                         placeholder: "ej., fa-building, home, apartment" %>
        <p class="mt-1 text-xs text-gray-500">
          Clase o nombre de icono opcional para mostrar.
        </p>
      </div>
    </div>
  </div>

  <!-- Translations -->
  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Etiquetas</h2>
      <p class="mt-1 text-sm text-gray-500">Ingresa el nombre para mostrar en cada idioma.</p>
    </div>
    <div class="px-6 py-4 space-y-4">
      <% I18n.available_locales.first(6).each do |locale| %>
        <div>
          <%= f.label "label_#{locale}", locale_name(locale), class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field "label_#{locale}",
                           value: @property_type.translations.dig(locale.to_s) || @property_type.translations.dig(locale),
                           class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500",
                           placeholder: "ej., Apartment, Apartamento, Appartement" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Visibility Options -->
  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Visibilidad</h2>
    </div>
    <div class="px-6 py-4 space-y-4">
      <div class="flex items-center">
        <%= f.check_box :visible, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
        <%= f.label :visible, class: "ml-2 text-sm text-gray-700" do %>
          <span class="font-medium">Visible</span>
          <span class="text-gray-500 ml-1">(Mostrar este tipo en listas desplegables y anuncios)</span>
        <% end %>
      </div>

      <div class="flex items-center">
        <%= f.check_box :show_in_search, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
        <%= f.label :show_in_search, class: "ml-2 text-sm text-gray-700" do %>
          <span class="font-medium">Mostrar en búsqueda</span>
          <span class="text-gray-500 ml-1">(Incluir en las opciones de filtro de búsqueda)</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="flex items-center justify-between pt-4">
    <div>
      <% if @property_type.persisted? %>
        <%= button_to "Eliminar",
                      site_admin_search_filters_property_type_path(@property_type),
                      method: :delete,
                      class: "text-red-600 hover:text-red-800 text-sm",
                      form: { data: { turbo_confirm: "¿Estás seguro de que deseas eliminar este tipo de propiedad?" } } %>
      <% end %>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Cancelar", site_admin_search_filters_property_types_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      <%= f.submit @property_type.persisted? ? "Actualizar tipo de propiedad" : "Crear tipo de propiedad",
                   class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 cursor-pointer" %>
    </div>
  </div>
<% end %>
