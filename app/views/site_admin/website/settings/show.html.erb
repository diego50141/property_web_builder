<div class="max-w-7xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">
      <% case @tab %>
      <% when 'general' %>
        Configuración general
      <% when 'appearance' %>
        Tema y apariencia
      <% when 'navigation' %>
        Navegación del sitio
      <% when 'notifications' %>
        Configuración de notificaciones
      <% when 'seo' %>
        Configuración de SEO
      <% when 'social' %>
        Enlaces sociales
      <% when 'search' %>
        Configuración de búsqueda
      <% else %>
        Configuración de <%= @tab.titleize %>
      <% end %>
    </h1>
    <p class="mt-2 text-gray-600">
      <% case @tab %>
      <% when 'general' %>
        Configura los ajustes básicos del sitio web
      <% when 'appearance' %>
        Personaliza el aspecto y el estilo de tu sitio
      <% when 'navigation' %>
        Gestiona los menús de navegación de tu sitio
      <% when 'notifications' %>
        Configura las preferencias de correo y notificaciones
      <% when 'seo' %>
        Optimiza tu sitio para los motores de búsqueda
      <% when 'social' %>
        Añade enlaces a tus perfiles de redes sociales
      <% when 'search' %>
        Configura las opciones y filtros de búsqueda de propiedades
      <% else %>
        Configura los ajustes de <%= current_website.subdomain %>
      <% end %>
    </p>
  </div>

  <!-- Tab Content -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <% case @tab %>
    <% when 'general' %>
      <%= render 'general_tab' %>
    <% when 'appearance' %>
      <%= render 'appearance_tab' %>
    <% when 'navigation' %>
      <%= render 'navigation_tab' %>
    <% when 'home' %>
      <%= render 'home_tab' %>
    <% when 'notifications' %>
      <%= render 'notifications_tab' %>
    <% when 'seo' %>
      <%= render 'seo_tab' %>
    <% when 'social' %>
      <%= render 'social_tab' %>
    <% when 'search' %>
      <%= render 'search_tab' %>
    <% end %>
  </div>
</div>
