<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-2">Importar propiedad desde URL</h1>
  <p class="text-gray-600 mb-8">
    Pega la URL de una propiedad de otro sitio web para importar sus detalles.
  </p>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center mb-4">
      <svg class="w-6 h-6 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
      </svg>
      <h2 class="text-lg font-semibold text-gray-900">Ingresa la URL de la propiedad</h2>
    </div>

    <%= form_with url: site_admin_property_url_import_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <div>
        <label for="url" class="block text-sm font-medium text-gray-700 mb-1">URL de la propiedad</label>
        <%= text_field_tag :url, params[:url],
            type: "url",
            placeholder: "https://www.rightmove.co.uk/properties/12345678",
            class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm",
            required: true,
            autofocus: true %>
        <p class="mt-1 text-sm text-gray-500">
          Pega la URL completa del anuncio de la propiedad que deseas importar.
        </p>
      </div>

      <div class="pt-4">
        <button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
          Obtener datos de la propiedad
        </button>
      </div>
    <% end %>
  </div>

  <!-- Supported Sites Info -->
  <div class="mt-8 bg-blue-50 rounded-lg p-6">
    <h2 class="text-lg font-semibold text-blue-900 mb-3">Sitios web compatibles</h2>
    <p class="text-sm text-blue-800 mb-4">
      El sistema intentará extraer los datos de la propiedad de cualquier sitio web. Se obtienen mejores resultados con estos portales inmobiliarios populares:
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
      <% if @pws_enabled && @supported_portals.present? %>
        <% @supported_portals.each do |portal| %>
          <div class="bg-white rounded px-3 py-2 text-center text-gray-700">
            <%= portal.to_s.titleize %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 ml-1">Extracción mejorada</span>
          </div>
        <% end %>
      <% end %>
      <div class="bg-white rounded px-3 py-2 text-center text-gray-700">Rightmove</div>
      <div class="bg-white rounded px-3 py-2 text-center text-gray-700">Zoopla</div>
      <div class="bg-white rounded px-3 py-2 text-center text-gray-700">Idealista</div>
      <div class="bg-white rounded px-3 py-2 text-center text-gray-700">OnTheMarket</div>
      <div class="bg-white rounded px-3 py-2 text-center text-gray-700">Zillow</div>
      <div class="bg-white rounded px-3 py-2 text-center text-gray-700">Realtor.com</div>
      <div class="bg-white rounded px-3 py-2 text-center text-gray-700">Redfin</div>
      <div class="bg-white rounded px-3 py-2 text-center text-gray-700">Cualquier sitio web</div>
    </div>
    <p class="mt-4 text-sm text-blue-700">
      <strong>Nota:</strong> Algunos sitios web pueden bloquear el acceso automático. En ese caso, podrás pegar el código fuente HTML de la página manualmente.
    </p>
  </div>

  <!-- Other Import Options -->
  <div class="mt-6 text-center">
    <p class="text-sm text-gray-500 mb-2">Otras opciones de importación:</p>
    <div class="flex justify-center gap-4">
      <%= link_to "Importación en bloque (CSV)", site_admin_property_import_export_path,
          class: "text-sm text-blue-600 hover:text-blue-800" %>
      <span class="text-gray-300">|</span>
      <%= link_to "Crear manualmente", new_site_admin_prop_path,
          class: "text-sm text-blue-600 hover:text-blue-800" %>
    </div>
  </div>
</div>
